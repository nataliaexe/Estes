
# === APP ===
APP_NAME=Estes
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=troque-por-uma-chave-forte-minimo-32-chars
API_V1_PREFIX=/api/v1
SQL_ECHO=false

# === BANCO (Postgres Docker - porta 5434) ===
DATABASE_URL=postgresql+asyncpg://estes:estes@localhost:5434/estes
DATABASE_URL_SYNC=postgresql://estes:estes@localhost:5434/estes

# === REDIS (Docker - porta 6380) ===
REDIS_URL=redis://localhost:6380/0

# === IA ===
GROQ_API_KEY=
GROQ_MODEL=groq/compound
GROQ_MODEL_FAST=groq/compound

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

TAVILY_API_KEY=
FIRMS_API_KEY=

# === EMBEDDINGS ===
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# === SEGURANCA ===
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === RATE LIMIT ===
IA_RATE_LIMIT=20/minute

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
